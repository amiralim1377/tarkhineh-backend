enum MembershipInvitationScope {
  ORGANIZATION
  BRANCH
}

enum MembershipInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model MembershipInvitation {
  id             String                     @id
  organizationId String
  branchId       String?
  email          String
  inviterUserId  String
  tokenHash      String                     @unique
  scope          MembershipInvitationScope
  status         MembershipInvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  inviter      User         @relation("MembershipInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email, scope, status])
  @@index([branchId, email, status])
  @@index([status, expiresAt])
  @@index([inviterUserId, createdAt])
}
