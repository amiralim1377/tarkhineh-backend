enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  roleAssignments     RoleAssignment[]
  permissionOverrides UserPermissionOverride[]
}
