enum PermissionEffect {
  ALLOW
  DENY
}

enum RoleDefinitionScope {
  SYSTEM
  ORGANIZATION
}

enum RoleAssignmentScope {
  ORGANIZATION
  BRANCH
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

model Role {
  id              String              @id @default(cuid())
  code            String
  name            String
  description     String?
  definitionScope RoleDefinitionScope
  assignmentScope RoleAssignmentScope
  organizationId  String?
  isAssignable    Boolean             @default(true)
  status          RoleStatus          @default(ACTIVE)
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation("OrganizationRoles", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([code], where: raw("\"definitionScope\" = 'SYSTEM'"))
  @@unique([organizationId, code], where: raw("\"definitionScope\" = 'ORGANIZATION'"))
  @@index([organizationId, status])
  @@index([createdById])
}

model Permission {
  id   String @id @default(cuid())
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleAssignment {
  id                       String  @id @default(cuid())
  roleId                   String
  organizationMembershipId String?
  branchMembershipId       String?
  assignedById             String?

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  role                   Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizationMembership OrganizationMembership? @relation("OrganizationMembershipRoleAssignments", fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  branchMembership       BranchMembership?       @relation("BranchMembershipRoleAssignments", fields: [branchMembershipId], references: [id], onDelete: Cascade)
  assignedBy             User?                   @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([organizationMembershipId, roleId], where: raw("\"organizationMembershipId\" IS NOT NULL AND \"revokedAt\" IS NULL"))
  @@unique([branchMembershipId, roleId], where: raw("\"branchMembershipId\" IS NOT NULL AND \"revokedAt\" IS NULL"))
  @@index([organizationMembershipId, revokedAt])
  @@index([branchMembershipId, revokedAt])
  @@index([roleId, revokedAt])
}

model UserPermissionOverride {
  id                       String           @id @default(cuid())
  organizationId           String
  organizationMembershipId String
  branchId                 String
  permissionId             String
  assignedById             String
  effect                   PermissionEffect

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationMembership OrganizationMembership @relation(fields: [organizationMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  branch                 Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  permission             Permission             @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  assignedBy             User                   @relation("PermissionOverrideActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([organizationMembershipId, branchId, permissionId])
  @@index([organizationMembershipId, organizationId])
  @@index([branchId, organizationId])
  @@index([permissionId])
  @@index([assignedById])
}
