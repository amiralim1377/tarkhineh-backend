enum PermissionEffect {
  ALLOW
  DENY
}

enum RoleScope {
  SYSTEM
  ORGANIZATION
  BRANCH
}

model Role {
  id              String          @id @default(cuid())
  code            String
  name            String
  description     String?
  scope           RoleScope       @default(SYSTEM)
  assignmentScope MembershipScope @default(BRANCH)
  organizationId  String?
  branchId        String?
  createdById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization? @relation("OrganizationRoles", fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation("BranchRoles", fields: [branchId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([code], where: raw("\"scope\" = 'SYSTEM'"))
  @@unique([organizationId, code], where: raw("\"scope\" = 'ORGANIZATION'"))
  @@unique([branchId, code], where: raw("\"scope\" = 'BRANCH'"))
  @@index([organizationId, scope])
  @@index([branchId, scope])
  @@index([createdById])
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RoleAssignment {
  id                       String  @id @default(cuid())
  roleId                   String
  organizationMembershipId String?
  branchMembershipId       String?
  assignedById             String?

  createdAt DateTime  @default(now())
  revokedAt DateTime?

  role                   Role                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organizationMembership OrganizationMembership? @relation("OrganizationMembershipRoleAssignments", fields: [organizationMembershipId], references: [id], onDelete: Cascade)
  branchMembership       BranchMembership?       @relation("BranchMembershipRoleAssignments", fields: [branchMembershipId], references: [id], onDelete: Cascade)
  assignedBy             User?                   @relation("RoleAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([organizationMembershipId, roleId], where: raw("\"organizationMembershipId\" IS NOT NULL AND \"revokedAt\" IS NULL"))
  @@unique([branchMembershipId, roleId], where: raw("\"branchMembershipId\" IS NOT NULL AND \"revokedAt\" IS NULL"))
  @@index([organizationMembershipId, revokedAt])
  @@index([branchMembershipId, revokedAt])
  @@index([roleId, revokedAt])
}

model UserPermissionOverride {
  id                 String           @id @default(cuid())
  branchMembershipId String
  permissionId       String
  assignedById       String
  effect             PermissionEffect

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchMembership BranchMembership @relation(fields: [branchMembershipId], references: [id], onDelete: Cascade)
  permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User             @relation("PermissionOverrideActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([branchMembershipId, permissionId])
  @@index([permissionId])
  @@index([assignedById])
}
