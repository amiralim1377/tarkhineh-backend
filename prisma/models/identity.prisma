enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum OAuthProvider {
  GOOGLE
}

enum OtpPurpose {
  SIGN_IN
  VERIFY_PHONE
  LINK_PHONE
}

model User {
  authSessions                AuthSession[]
  id                          String                       @id @default(cuid())
  email                       String?                      @unique
  emailVerifiedAt             DateTime?
  passwordHash                String?
  phone                       String?                      @unique
  phoneVerifiedAt             DateTime?
  displayName                 String?
  status                      UserStatus                   @default(PENDING)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  emailVerificationChallenges EmailVerificationChallenge[]
  passwordResetChallenges     PasswordResetChallenge[]

  oauthAccounts              OAuthAccount[]
  ownedOrganizations         Organization[]           @relation("OrganizationOwner")
  organizationMemberships    OrganizationMembership[] @relation("UserOrganizationMemberships")
  createdRoles               Role[]                   @relation("RoleCreator")
  createdRoleAssignments     RoleAssignment[]         @relation("RoleAssignmentActor")
  createdPermissionOverrides UserPermissionOverride[] @relation("PermissionOverrideActor")

  @@index([status])
}

model PasswordResetChallenge {
  id            String    @id @default(cuid())
  userId        String
  email         String
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, invalidatedAt, expiresAt])
  @@index([email, expiresAt])
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  emailAtProvider   String?
  userId            String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model OtpChallenge {
  id             String     @id @default(cuid())
  phone          String
  codeHash       String
  purpose        OtpPurpose @default(SIGN_IN)
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int        @default(0)
  createdAt      DateTime   @default(now())

  @@index([phone, purpose, expiresAt])
}

model EmailVerificationChallenge {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email, expiresAt])
}

enum AuthSessionRevocationReason {
  LOGOUT
  REFRESH_TOKEN_REUSE
  SECURITY_ACTION
}

model AuthSession {
  id     String @id @default(cuid())
  userId String

  createdAt        DateTime                     @default(now())
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revocationReason AuthSessionRevocationReason?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id                String    @id @default(cuid())
  sessionId         String
  tokenHash         String    @unique
  csrfTokenHash     String
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @unique

  session         AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId, expiresAt])
  @@index([sessionId, usedAt])
  @@index([expiresAt])
}
